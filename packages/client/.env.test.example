# Copy to .env.test and fill in values (or run: node scripts/setup-e2e-account.mjs)
# .env.test is gitignored — never commit real passwords.

# Web client base URL (production self-hosted instance)
E2E_BASE_URL=https://stoat.viniciusrangel.dev/app

# API base URL
E2E_API_URL=https://stoat.viniciusrangel.dev/api

# Dedicated E2E test account (create via scripts/setup-e2e-account.mjs)
E2E_EMAIL=stoat-e2e+test@example.com
E2E_PASSWORD=change-me-use-setup-script

# Server + default text channel the test user owns
E2E_SERVER_ID=
E2E_CHANNEL_ID=
