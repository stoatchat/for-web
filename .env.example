# Deployment target for ./deploy.sh
# Copy to .env and fill in — .env is gitignored, this file is not.

# SSH destination of the instance serving the built client
DEPLOY_HOST=user@my-instance.example
DEPLOY_SSH_PORT=22
# DEPLOY_SSH_KEY=~/.ssh/id_ed25519

# Where the built client lands, and the systemd unit serving it
# DEPLOY_PATH=/opt/stoat-web/dist/
# DEPLOY_SERVICE=stoat-web

# Printed once the deploy succeeds
# DEPLOY_URL=https://my-instance.example
